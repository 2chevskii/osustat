{
  "include": [
    "./src"
  ],
  "exclude": [
    "./node_modules"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": [
      "./src/**/*.js"
    ]
  },
  "compilerOptions": {
    "allowJs": true,
    "maxNodeModuleJsDepth": 0,
    "strict": true,
    "checkJs": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ]
  }
}
