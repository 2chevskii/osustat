{
  "include": [
    "./src"
  ],
  "exclude": [
    "./node_modules"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": [
      "./src/**/*.js",
      "./node_modules/**/*.{js,ts,d.ts}"
    ]
  },
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "checkJs": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ]
  }
}
