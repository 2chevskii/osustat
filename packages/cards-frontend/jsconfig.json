{
  "extends": "../../jsconfig.json",
  "include": [
    "./src/*.js"
  ],
  "exclude": [
    "./node_modules"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": [
      "./*.js",
      "./*.mjs"
    ]
  },
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "types": [
      "vite/client"
    ]
  }
}