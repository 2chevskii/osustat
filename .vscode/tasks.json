{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start dev docker-compose",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--project-directory",
        "${workspaceFolder}/packages/api",
        "-f",
        "${workspaceFolder}/packages/api/docker-compose.yaml",
        "up",
        "--detach"
      ],
      "problemMatcher": []
    },
    {
      "label": "Stop dev docker-compose",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "--project-directory",
        "${workspaceFolder}/packages/api",
        "-f",
        "${workspaceFolder}/packages/api/docker-compose.yaml",
        "down"
      ],
      "problemMatcher": []
    }
  ]
}
