{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "dev(api)",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/packages/api",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "name": "dev(cards-frontend)",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/packages/cards-frontend",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "name": "dev(api, docker-compose)",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/packages/api",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "restart": true,
      "preLaunchTask": "api/docker-compose::start",
      "postDebugTask": "api/docker-compose::stop",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "dev(api, cards-frontend)",
      "configurations": [
        "dev(api)",
        "dev(cards-frontend)"
      ],
      "stopAll": true
    },
    {
      "name": "dev(*)",
      "configurations": [
        "dev(api, docker-compose)",
        "dev(cards-frontend)"
      ],
      "stopAll": true
    }
  ]
}