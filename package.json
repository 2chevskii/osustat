{
  "name": "osustat",
  "private": true,
  "workspaces": [
    "packages/api",
    "packages/profile-cards"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@osustat/api",
    "dev:cards": "npm run dev --workspace=@osustat/profile-cards",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint packages scripts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p jsconfig.scripts.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
